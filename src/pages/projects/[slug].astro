---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import StatusLabel from '../../components/projects/StatusLabel.astro';
import Diagram from '../../components/diagrams/Diagram.astro';
import type { Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const d = project.data;
const { Content } = await render(project);
const statusLine = { production: null, competition: `Champion · ${d.meta}`, hackathon: `Hackathon · ${d.meta}`, team: `Team project · ${d.meta}` }[d.status];
---
<Base title={`${d.name} · JV Faigao`} description={d.intro} navActive="projects">
  <main class="wrap pp">
    <a class="tlink" href="/projects" style="display: inline-block; margin-top: 32px; font-size: 15px">All projects</a>

    <section style="padding: 28px 0 56px; border-bottom: 1px solid var(--line)">
      <div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 32px">
        <h1 class="disp" style={`margin: 0; font-size: clamp(56px, 8vw, 112px); line-height: .86; overflow-wrap: anywhere; view-transition-name: p-${project.id}`}>{d.name}</h1>
        {d.status === 'production' ? <span style="font-size: 15px"><StatusLabel status={d.status} variant="page" /></span> : <span style="font-size: 15px">{statusLine}</span>}
      </div>
      <p style="margin: 16px 0 0; max-width: 60ch; font-size: 19px">{d.intro}</p>
      <p class="pp-meta" style="margin: 12px 0 0; font-size: 15px; color: var(--muted)">
        {d.role} · {d.year} · {d.stack.join(', ')}
        {d.liveUrl && <> · <a href={d.liveUrl} class="tlink ext">{d.liveLabel} <Icon name="arrow" size={11} stroke={2.2} /></a></>}
        {d.repoUrl && <> · <a href={d.repoUrl} class="tlink ext">View code <Icon name="arrow" size={11} stroke={2.2} /></a></>}
      </p>
      {d.result && (
        <div class="result" style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 20px; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--line)">
          <span style="font-size: 15px; color: var(--muted)">Result</span>
          <span class="disp" style="font-size: clamp(44px, 5vw, 64px); line-height: .9; color: var(--red)">{d.result.headline}</span>
          <span style="font-size: 18px; max-width: 44ch">{d.result.line}</span>
        </div>
      )}
    </section>

    {d.recognition && (
      <section id="recognition" class="sec" style="border-top: 0; border-bottom: 1px solid var(--line); padding: 56px 0">
        <h2 style="margin: 0 0 24px">Recognition</h2>
        <div class="shots">
          {d.recognition.map((r) => (
            <figure style="margin: 0">
              <a class="shot" href={r.src.src} aria-label={`${r.alt} (full size)`}>
                <Image src={r.src} alt={r.alt} widths={[640, 1280]} sizes="(max-width: 640px) 100vw, 580px" />
              </a>
              <figcaption style="margin-top: 10px; font-size: 14px; color: var(--muted)">{r.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="sec pp-body" style="border-top: 0; padding: 56px 0">
      <Content />
    </section>

    {d.quote && (
      <section class="sec" style="padding: 56px 0">
        <figure style="margin: 0; max-width: 820px">
          <div class="disp" aria-hidden="true" style="font-size: 120px; line-height: .6; color: var(--red); height: 54px">“</div>
          <blockquote style="margin: 0; font-size: clamp(22px, 2.6vw, 30px); line-height: 1.35; font-weight: 500; letter-spacing: -0.01em">{d.quote.text}</blockquote>
          <figcaption style="margin-top: 20px; font-size: 16px; color: var(--muted)">{d.quote.by}</figcaption>
        </figure>
      </section>
    )}

    <section class="sec" style="padding: 56px 0">
      <h2 style="margin: 0 0 32px">How it works</h2>
      <Diagram name={d.diagram} />
    </section>

    <section class="sec" style="padding: 56px 0">
      <h2 style="margin: 0 0 24px">Screenshots</h2>
      {d.demo && (
        <video class="demo" muted loop playsinline controls preload="none" width={d.demo.width} height={d.demo.height} poster={`/media/${project.id}.webp`} aria-label={d.demo.label}>
          <source src={`/media/${project.id}.mp4`} type="video/mp4" />
        </video>
      )}
      <div class="shots">
        {d.screenshots.map((s) => (
          <a class:list={['shot', { portrait: s.src.height > s.src.width }]} href={s.src.src} aria-label={`${s.alt} (full size)`}>
            <Image src={s.src} alt={s.alt} widths={[480, 960]} sizes="(max-width: 640px) 100vw, 400px" />
          </a>
        ))}
      </div>
    </section>

    <section class="sec" style="padding: 64px 0 88px">
      <p style="margin: 0 0 24px; font-size: 22px; font-weight: 500; max-width: 40ch">Interested in working together?</p>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 20px">
        <a class="btn-red pill-red" href="/JV-Faigao-CV.pdf" download style="min-height: 44px; padding: 0 20px">
          <Icon name="download" size={16} stroke={2} />
          Download CV
        </a>
        <a class="tlink" href="/#contact" style="font-size: 16px">Send a message</a>
      </div>
    </section>
  </main>
</Base>

<script>
  // Play the demo only while it is on screen; never autoplay for reduced motion or after the visitor paused it.
  const video = document.querySelector<HTMLVideoElement>('video.demo');
  if (video && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let visible = false;
    let pausedByVisitor = false;
    video.addEventListener('pause', () => {
      if (visible && document.visibilityState === 'visible') pausedByVisitor = true;
    });
    video.addEventListener('play', () => (pausedByVisitor = false));
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible && !pausedByVisitor) video.play().catch(() => {});
        else if (!visible) video.pause();
      },
      { threshold: 0.5 },
    ).observe(video);
  }
</script>
