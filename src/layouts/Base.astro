---
import '@fontsource/big-shoulders-display/latin-800';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import type { NavKey } from '../lib/activeSection';

interface Props {
  title: string;
  description: string;
  navActive: NavKey;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, navActive, ogImage = '/og.png', noindex = false } = Astro.props;
// Built pages live in folders (/projects/), but every link uses /projects, so drop the trailing slash.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Set the theme before first paint so there is no flash.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark');
      })();
    </script>
  </head>
  <body>
    <Header active={navActive} />
    <slot />
    <Footer />
    <BottomNav active={navActive} />
    <script is:inline>
      // Text reveal. Inline at the end of <body> so it runs before the first paint: no flash of text that then hides.
      // Every heading, paragraph, bullet and card in <main> rises in when it scrolls into view.
      // Skipped: the hero (CSS load animation), the contact form, the footer and the diagrams (they draw in themselves).
      (function () {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        root.classList.add('rv');
        var SEL = [
          'main h1', 'main h2', 'main h3', 'main p', 'main li', 'main blockquote', 'main figcaption',
          '.quote-mark', '.step-num', '.cat-ico', '.inst span', '.social', '.btn-white-out', '#about .two > div:last-child > div > div',
          '.row', '.cta-band .wrap > div', '.pp > a.tlink', '.result > *', '.demo', '.shot', '.pp .sec > div:last-child:not(.shots)',
        ].join(',');
        var SKIP = '#top, .cform, footer, .diag-wide, .diag-narrow, .social *';
        var items = [];
        document.querySelectorAll(SEL).forEach(function (el) {
          if (el.closest(SKIP) || (el.parentElement && el.parentElement.closest('.rv-item'))) return;
          el.classList.add('rv-item');
          items.push(el);
        });
        var io = new IntersectionObserver(function (entries) {
          var n = 0;
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            // Things that enter together come in one after another, kept short so the first screen is ready in about 0.6s.
            e.target.style.transitionDelay = Math.min(n++, 5) * 40 + 'ms';
            e.target.classList.add('rv-in');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -6% 0px' });
        root.classList.add('rv-ready');
        // Turn transitions on only after the hidden state has painted; Safari would otherwise fade the text OUT first.
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            root.classList.add('rv-armed');
            items.forEach(function (el) { io.observe(el); });
          });
        });
      })();
    </script>
  </body>
</html>
