---
// Wireframe thumbnails exactly as drawn on the design canvas, one per project.
interface Props {
  variant: 'ja1' | 'marami' | 'urban' | 'degz' | 'faceattend' | 'ambagpay' | 'thesis';
}
const { variant: v } = Astro.props;
const lines: Record<string, (string | null)[]> = {
  ja1: ['55%', null, null, '75%'],
  urban: ['45%', null, '70%', null],
  thesis: ['60%', null, null],
};
const withSidebar = v === 'ja1' || v === 'urban' || v === 'thesis';
---
<div class="th" aria-hidden="true">
  {withSidebar && <div class="sb"></div>}
  {lines[v] && (
    <div class="bd">{lines[v].map((w) => <div class="ln" style={w ? `width: ${w}` : undefined}></div>)}</div>
  )}
  {v === 'marami' && (
    <div class="bd">
      <div class="ln" style="width: 40%"></div>
      <div style="flex: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 5px">
        <div class="tile"></div><div class="tile"></div><div class="tile"></div>
      </div>
    </div>
  )}
  {v === 'degz' && (
    <div class="bd">
      <div class="ln" style="width: 50%"></div>
      <div style="flex: 1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px">
        <div class="tile"></div><div class="tile"></div><div class="tile" style="background: var(--red); opacity: .5"></div><div class="tile"></div>
      </div>
    </div>
  )}
  {v === 'faceattend' && (
    <div class="bd" style="align-items: center; justify-content: center">
      <div style="width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--red)"></div>
      <div class="ln" style="width: 60%"></div>
    </div>
  )}
  {v === 'ambagpay' && (
    <div class="bd">
      <div class="ln" style="width: 50%"></div><div class="ln"></div><div class="ln" style="width: 30%; background: var(--red); opacity: .6"></div><div class="ln"></div>
    </div>
  )}
</div>
