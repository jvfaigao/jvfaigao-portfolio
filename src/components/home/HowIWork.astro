---
const steps = [
  ['Understand', "I learn how the client's team works today before deciding what to build."],
  ['Plan', 'I write a plan and a proposal the client approves before any code.'],
  ['Build', "I ship in phases and test on the client's real devices."],
  ['Support', 'I stay on after launch to fix, adjust and maintain the system.'],
];
---
<section id="how" class="sec">
  <div class="wrap">
    <h2 class="disp h-disp">HOW I WORK</h2>
    <div class="steps">
      {steps.map(([title, text], i) => (
        <div>
          <div class="step-num">{String(i + 1).padStart(2, '0')}</div>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
