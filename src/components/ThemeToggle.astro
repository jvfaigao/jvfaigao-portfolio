---
import Icon from './Icon.astro';
---
<button type="button" class="theme-btn" data-theme-toggle aria-label="Switch to light theme">
  <Icon name="sun" size={18} class="ico-sun" />
  <Icon name="moon" size={18} class="ico-moon" />
</button>

<script>
  import { storeTheme, type Theme } from '../lib/theme';

  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function label(theme: Theme) {
    btn?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  }

  label(root.dataset.theme === 'light' ? 'light' : 'dark');
  btn?.addEventListener('click', () => {
    const next: Theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    const apply = () => {
      root.dataset.theme = next;
      label(next);
    };
    // Cross-fade the whole page where supported; elsewhere (or with reduced motion) switch at once.
    if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(apply);
    else apply();
    storeTheme(next);
  });
</script>
